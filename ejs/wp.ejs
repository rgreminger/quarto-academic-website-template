```{=html}

<% for (const item of items) { %>
    <div class="list grid" style="column-gap: 5px;">
        <div class="g-col-12 g-col-lg-8 g-col-md-9 g-col-sm-9">
        <b><a class="paper-title" href="<%- item.path %>"><%= item.title %></a></b><br/>
        <% if (item.coauthors) { %>
            <% if (item.coauthors.length == 1) { %>
                Joint with <% if (item.coauthors[0].link) { %><a class="coauthor" href="<%- item.coauthors[0].link %>"><%= item.coauthors[0].name %></a><% } else { %><%= item.coauthors[0].name %><% } %>.<br/>
            <% } else { %>
                Joint with 
                <% for (const coauthor of item.coauthors.slice(0, -2)) { %>
                    <% if (coauthor.link) { %>
                        <a class="coauthor" href="<%- coauthor.link %>"><%= coauthor.name %></a>,
                    <% } else { %>
                        <%= coauthor.name %>,
                    <% } %>
                <% } %>
                <% if (item.coauthors[item.coauthors.length - 2].link) { %>
                    <a class="coauthor" href="<%- item.coauthors[item.coauthors.length - 2].link %>"><%= item.coauthors[item.coauthors.length - 2].name %></a>
                <% } else { %>
                    <%= item.coauthors[item.coauthors.length - 2].name %>
                <% } %>
                <% if (item.coauthors[item.coauthors.length - 1].link) { %>
                    and <a class="coauthor" href="<%- item.coauthors[item.coauthors.length - 1].link %>"><%= item.coauthors[item.coauthors.length - 1].name %></a>.<br/>
                <% } else { %>
                    and <%= item.coauthors[item.coauthors.length - 1].name %>.<br/>
                <% } %>
            <% } %>
        <% } %>
    <% if (item.note) { %>
        <i><%= item.note %></i><br/>
    <% } %>
    <% if (item.links) { %>
        <% for (const link of item.links) { %>
            <a class="btn btn-outline-primary btn-sm scale" href="<%- link.url %>"><%= link.label %></a>
        <% } %>
    <% } %>
    </div>
    <div class="image_list g-col-8 g-col-lg-4 g-col-md-3 g-col-sm-3"> 
        <% if (item.image) { %>
            <a class="image-link" href="<%- item.path %>">
                <img src="<%- item.image %>" alt="image" width="100%">
            </a>
    <% } %>
    </div>
    <br> 

    </div>
<% } %>
```